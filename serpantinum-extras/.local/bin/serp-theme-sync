#!/usr/bin/env bash
# Follow serpantinum's theme into nvim (~/.config/nvim/matugen_colors.lua, live-reloaded by init.lua).
# Serpantinum v2 runs matugen with its own config, so re-run my personal matugen config with the
# same inputs. Triggered by serp-theme-sync.path when serpantinum's palette changes.
set -uo pipefail
settings="${XDG_CONFIG_HOME:-$HOME/.config}/serpantinum/settings.json"
wall="${XDG_CACHE_HOME:-$HOME/.cache}/serpantinum/wallpaper/current_wallpaper.png"
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/matugen/config.toml"

# Static presets (no wallpaper colours) keep the last generated colours.
[ "$(jq -r '.theme.matugen // true' "$settings" 2>/dev/null)" = "true" ] || exit 0
[ -s "$wall" ] || exit 0

mode="$(jq -r '.theme.mode // "dark"' "$settings" 2>/dev/null)"
type="$(jq -r '.theme.schemeType // "scheme-tonal-spot"' "$settings" 2>/dev/null)"
exec nice -n 15 matugen image "$wall" -c "$cfg" -m "$mode" -t "$type" --source-color-index 0
