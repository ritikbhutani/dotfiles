#!/usr/bin/env bash
# Apply the default wallpaper once per machine (fresh installs), then never again.
# Run from Hyprland autostart. Serpantinum's first launch picks a random wallpaper,
# so wait for its IPC to come up and let that settle before overriding it.
set -uo pipefail
DEFAULT="${SERP_DEFAULT_WALLPAPER:-$HOME/Pictures/Wallpapers/4k/ddg_1776373765829978071.jpg}"
MARKER="${XDG_STATE_HOME:-$HOME/.local/state}/serpantinum/default-wallpaper.applied"

[ -e "$MARKER" ] && exit 0
[ -f "$DEFAULT" ] || exit 0

for _ in $(seq 1 60); do
  serpantinum info wallpaper >/dev/null 2>&1 && break
  sleep 1
done
sleep 5

serpantinum set wallpaper "$DEFAULT" all && mkdir -p "$(dirname "$MARKER")" && date -Is > "$MARKER"
